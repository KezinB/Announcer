# Target configuration
CONFIG_IDF_TARGET="esp32s3"

# Compiler Optimization (Use size optimization -Os to avoid GCC 15.2 IRA bug under -Og)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Board: ESP32-S3 N16R8 (16 MB flash, 8 MB octal PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# CPU and Task Configuration
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# Console Configuration (Support both UART0 and USB Serial/JTAG ports)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Default Log Level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
