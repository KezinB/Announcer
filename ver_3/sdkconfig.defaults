# Target configuration
CONFIG_IDF_TARGET="esp32s3"

# Compiler Optimization (Use size optimization -Os to avoid GCC 15.2 IRA bug under -Og)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Board: ESP32-S3 N16R8 (16 MB flash, 8 MB octal PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Audio: MAX98357A I2S amplifier (ver_2)
CONFIG_AUDIO_MODE_EXTERNAL_I2S_CONFIG=y
CONFIG_I2S_EXT_BCLK_GPIO=5
CONFIG_I2S_EXT_LRCK_GPIO=6
CONFIG_I2S_EXT_DOUT_GPIO=4

# Custom partitions: 6 MB app to hold embedded voice clips
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU and Task Configuration
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# Console Configuration (Support both UART0 and USB Serial/JTAG ports)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Default Log Level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
